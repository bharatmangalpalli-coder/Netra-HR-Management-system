rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    function isAdmin() { 
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        request.auth.token.email == 'netragroupofservices@gmail.com'
      );
    }

    function isEmployee(employeeId) {
      return isSignedIn() && (
        request.auth.uid == employeeId || 
        (exists(/databases/$(database)/documents/employees/$(request.auth.uid)) && get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.employeeId == employeeId)
      );
    }

    function isOwnerOfDoc(data) {
      return isSignedIn() && (
        (data.userId != null && data.userId == request.auth.uid) ||
        (data.employeeId != null && data.employeeId == request.auth.uid) ||
        (data.assignedTo != null && data.assignedTo == request.auth.uid)
      );
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Employees collection
    match /employees/{employeeId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() || (isOwner(employeeId) && isValidId(employeeId));
      allow update: if isAdmin() || (
        (isOwner(employeeId) || isOwnerOfDoc(existing())) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['mobile', 'address', 'bankName', 'accountNumber', 'ifscCode', 'userId'])
      );
      allow delete: if isAdmin();
    }

    // Attendance collection
    function isValidAttendance(data) {
      return data.employeeId is string && 
             data.date is string && 
             data.markedAt == request.time;
    }

    match /attendance/{attendanceId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && 
                   (isEmployee(incoming().employeeId) || isAdmin()) &&
                   isValidAttendance(incoming());
      allow update: if isAdmin() || (
        (isOwnerOfDoc(existing()) || isEmployee(existing().employeeId)) && 
        incoming().diff(existing()).affectedKeys().hasOnly([
          'outTime', 'outSelfieUrl', 
          'status', 'totalHours', 'checkOut',
          'userId', 'updatedAt', 'isManualTime'
        ]) &&
        incoming().updatedAt == request.time
      );
      allow delete: if isAdmin();
    }

    // Leaves collection
    match /leaves/{leaveId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isEmployee(incoming().employeeId) || isAdmin());
      allow update: if isAdmin() || isOwnerOfDoc(existing());
      allow delete: if isAdmin() || isOwnerOfDoc(existing());
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        (isOwnerOfDoc(existing()) || isEmployee(existing().assignedTo)) && 
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'comments'])
      );
      allow delete: if isAdmin();
    }

    // Salary collection
    match /salary/{salaryId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Permissions collection
    match /permissions/{permissionId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && (isEmployee(incoming().employeeId) || isAdmin());
      allow update: if isAdmin() || isOwnerOfDoc(existing());
      allow delete: if isAdmin() || isOwnerOfDoc(existing());
    }

    // Settings collection
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
